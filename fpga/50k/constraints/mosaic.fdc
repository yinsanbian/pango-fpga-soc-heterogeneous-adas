set_false_path -from [get_ports {eth_mdio_0}] -to [get_cells {u_phy_diag.mdio0_meta}]
set_false_path -from [get_ports {eth_mdio_1}] -to [get_cells {u_phy_diag.mdio1_meta}]
# No multicycle, source-synchronous RGMII, or ordinary-reset exception is added.
