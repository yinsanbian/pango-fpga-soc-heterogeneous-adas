# RX1 envelope matches qualified RX0: PHY RX delay OFF, package skew +/-0.5ns.
# This is an explicit design assumption, not measured PHY strap/PCB evidence.
set_input_delay -clock [get_clocks {rgmii_data_edge_clk_1}] -max {0.500} [get_ports {eth_rgmii_rx_ctl_1 eth_rgmii_rxd_1[*]}]
set_input_delay -clock [get_clocks {rgmii_data_edge_clk_1}] -min {-0.500} [get_ports {eth_rgmii_rx_ctl_1 eth_rgmii_rxd_1[*]}]
# Compensated RX PLL uses the normal same-half-byte pairing: rise samples
# low nibble launched at 0ns, fall samples high nibble launched at 4ns.
# No RX1 multicycle exception: restoring default setup also TIGHTENS hold
# by 4ns versus the former MC0 model. Real PLL phase is +1ns, inferred above.
# External TX setup/hold is NOT signed off here: actual PHY TXDLY/variant and
# PCB clock-data skew are unknown. No invented output_delay or output false-path.
# Reference: Realtek RTL8211E/G v1.7 Table66, TskewR=1..2.6ns.
# Top integration must add new reset/FIFO/mailbox exact-instance protection.

# BEGIN SYSTEM FLOW MAILBOX CDC
# Req/ack are the only asynchronous control entries. Bundle FFs stay held
# from send until acknowledgement; destination waits two extra settle edges.
# 8ns datapath bound is below even the earliest capture (~3 destination cycles).
foreach mailbox_instance {u_context_mailbox u_uart_rx_mailbox u_uart_core_mailbox u_network_diag.u_net0_mailbox u_network_diag.u_net1_mailbox u_network_diag.u_core_mailbox} {
    foreach mailbox_ff {req_meta req_sync ack_meta ack_sync} {
        define_attribute [format {i:%s.%s} $mailbox_instance $mailbox_ff] {PAP_ASYNC_REG} {TRUE}
    }
    set_false_path -from [get_cells [format {%s.req_toggle} $mailbox_instance]] -to [get_cells [format {%s.req_meta} $mailbox_instance]]
    set_false_path -from [get_cells [format {%s.ack_toggle} $mailbox_instance]] -to [get_cells [format {%s.ack_meta} $mailbox_instance]]
    set_max_delay -datapath_only 8.000 -from [get_cells [format {%s.held_data[*]} $mailbox_instance]] -to [get_cells [format {%s.dst_data[*]} $mailbox_instance]]
    set_false_path -hold -from [get_cells [format {%s.held_data[*]} $mailbox_instance]] -to [get_cells [format {%s.dst_data[*]} $mailbox_instance]]
}
# END SYSTEM FLOW MAILBOX CDC

# Additional RX recovery control synchronizers; no source-synchronous path cut.
define_attribute {i:u_net1_fifo_rst.stages[*]} {PAP_ASYNC_REG} {TRUE}
define_attribute {i:u_rx_recovery.lock_sync[*]} {PAP_ASYNC_REG} {TRUE}
# LOCK directly reaches only bit0. Match the ADS vector object; -from LOCK
# cannot cut the bit0 Q->bit1 D registered path, which remains fully timed.
set_false_path -from [get_pins {u_rx_recovery.u_pll/LOCK}] -to [get_cells {u_rx_recovery.lock_sync[*]}]

# RX PLL watchdog digital state resets release in sys50, independently of CFG.
define_attribute {i:u_rx_recovery.u_control_rst.stages[*]} {PAP_ASYNC_REG} {TRUE}

# Diagnostic PIX lock observation; keep interstage setup/hold timed.
define_attribute {i:u_network_diag.lock_meta} {PAP_ASYNC_REG} {TRUE}
define_attribute {i:u_network_diag.lock_sync} {PAP_ASYNC_REG} {TRUE}
set_false_path -from [get_pins {u_rx_recovery.u_pll/LOCK}] -to [get_cells {u_network_diag.lock_meta}]

