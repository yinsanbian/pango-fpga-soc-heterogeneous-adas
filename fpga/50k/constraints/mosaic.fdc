# Each external MDIO enters exactly one protected two-FF chain.
# Only pad->first-stage D is asynchronous; interstage and all FSM paths stay timed.
define_attribute {i:u_phy_diag.mdio0_meta} {PAP_ASYNC_REG} {TRUE}
define_attribute {i:u_phy_diag.mdio0_sync} {PAP_ASYNC_REG} {TRUE}
