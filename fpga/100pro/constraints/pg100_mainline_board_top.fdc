# New application clocks; RXC is not used as MDIO/TX clock.
create_clock -name {hdmi_pclk} -period {6.734006734} [get_ports {hd_rx_pclk}]
create_clock -name {rgmii_rx_clk} -period {8.0} [get_ports {rgmii_rxc}]
create_generated_clock -name {rgmii_rx_pll_clk} -source [get_ports {rgmii_rxc}] -master_clock [get_clocks {rgmii_rx_clk}] [get_pins {network/pins/rx_pll/u_gpll:CLKOUT0}] -edges {1 2 3} -edge_shift {0.625 0.625 0.625}
create_generated_clock -name {hdmi_tx_clk} -source [get_ports {hd_rx_pclk}] -divide_by {1} [get_ports {hd_tx_pclk}]
set_false_path -from [get_ports {rst_board uart_rxd}]
set_false_path -to [get_ports {uart_txd led[0] led[1] led[2] led[3] led[4] led[5]}]
# External DDR/HDMI/RGMII min/max delays require board/PHY AC evidence. No fabricated delays or blanket IO exceptions.
# Factory PHY training/reset is asynchronous at these hardware primitive pins only.
# Keep ddrphy_sysclk <-> phy_dq_sysclk_* setup/hold and 0.4ns uncertainty active.
# Bind the actual vendor reset nets; macro logical pins are renamed during primitive mapping.
set_false_path -from [get_clocks {rst_clk}] -through [get_nets {I_ips_ddr_top.u_ddrphy_top.ddrphy_iol_rst I_ips_ddr_top.u_ddrphy_top.ddrphy_dqs_rst}] -to [get_clocks {phy_dq_clk_0 phy_dq_clk_1 phy_dq_sysclk_0 phy_dq_sysclk_1}]
