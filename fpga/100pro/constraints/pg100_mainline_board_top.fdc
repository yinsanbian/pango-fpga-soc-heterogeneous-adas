set_false_path -from [get_clocks {rst_clk}] -through [get_nets {I_ips_ddr_top.u_ddrphy_top.ddrphy_cpd_rstn}] -to [get_clocks {phy_dq_sysclk_0}]
# Factory PLL phase controller directly consumes the board physical reset.
